# Server-only. Configure this in Vercel; never prefix it with VITE_.
OPENAI_API_KEY=sk-project-example
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: restrict API requests to the deployed public origin.
APP_ORIGIN=https://your-domain.example

# Client-visible Supabase project settings (safe to expose when RLS is enabled).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional analytics. Leave blank to disable PostHog.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
